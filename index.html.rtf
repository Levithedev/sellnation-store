<body>\
    <!-- Header -->\
    <div class="header">\
        <div class="header-content">\
            <div class="logo">\
                \uc0\u55357 \u57042  SellNation\
            </div>\
            <div id="headerActions">\
                <button class="btn btn-primary" onclick="openLoginModal()">Staff Login</button>\
            </div>\
        </div>\
    </div>\
\
    <!-- Login Modal -->\
    <div id="loginModal" class="modal">\
        <div class="modal-content">\
            <h2 class="modal-title">Staff Login</h2>\
            <div class="form-group">\
                <label class="form-label">Username</label>\
                <input type="text" id="loginUsername" class="form-input" placeholder="Enter username">\
            </div>\
            <div class="form-group">\
                <label class="form-label">Password</label>\
                <input type="password" id="loginPassword" class="form-input" placeholder="Enter password">\
            </div>\
            <div id="loginError" class="error-message" style="display: none;"></div>\
            <div class="btn-group">\
                <button class="btn btn-primary" onclick="handleLogin()">Login</button>\
                <button class="btn btn-danger" onclick="closeLoginModal()">Cancel</button>\
            </div>\
        </div>\
    </div>\
\
    <!-- Main Container -->\
    <div class="container">\
        <!-- Staff Panel (hidden by default) -->\
        <div id="staffPanel" style="display: none;">\
            <div class="staff-panel">\
                <h2 class="panel-title">\uc0\u55357 \u57057 \u65039  Staff Panel</h2>\
                <div class="form-group">\
                    <input type="text" id="productName" class="form-input" placeholder="Product Name">\
                </div>\
                <div class="form-group">\
                    <input type="number" id="productPrice" class="form-input" placeholder="Price (Robux)">\
                </div>\
                <div class="form-group">\
                    <textarea id="productDescription" class="form-input" placeholder="Description (optional)"></textarea>\
                </div>\
                <button class="btn btn-success" onclick="addProduct()" style="width: 100%;">\uc0\u10133  Add Product</button>\
            </div>\
        </div>\
\
        <!-- Products Section -->\
        <div>\
            <h2 style="font-size: 28px; font-weight: bold; margin-bottom: 25px;">Available Products</h2>\
            <div id="productsContainer"></div>\
        </div>\
\
        <!-- Hub Banner -->\
        <div class="hub-banner">\
            <h3 class="hub-title">Visit Our Roblox Hub</h3>\
            <p class="hub-description">Complete your purchase in-game at SellNation Hub</p>\
            <button class="btn btn-primary" onclick="openRobloxHub()" style="background: white; color: #7c3aed;">\
                Open SellNation Hub\
            </button>\
        </div>\
    </div>\
\
    <script>\
        // Staff accounts\
        const STAFF_ACCOUNTS = \{\
            'admin': \{ password: 'staffsn', role: 'staff' \},\
            'Manger': \{ password: 'mangerSN', role: 'admin' \},\
            'Ownerschip': \{ password: 'OwnerSchipSNSELLNATION', role: 'ownership' \}\
        \};\
\
        const ROBLOX_HUB_URL = 'https://www.roblox.com/games/93196206649296/SellNation-Hub';\
\
        let currentUser = null;\
        let products = [];\
\
        // Load data on page load\
        window.addEventListener('DOMContentLoaded', () => \{\
            loadData();\
            renderProducts();\
        \});\
\
        function loadData() \{\
            try \{\
                const productsData = localStorage.getItem('sellnation_products');\
                if (productsData) \{\
                    products = JSON.parse(productsData);\
                \}\
                \
                const sessionData = localStorage.getItem('sellnation_session');\
                if (sessionData) \{\
                    currentUser = JSON.parse(sessionData);\
                    updateUIForLoggedInUser();\
                \}\
            \} catch (error) \{\
                console.log('No existing data found');\
            \}\
        \}\
\
        function saveProducts() \{\
            try \{\
                localStorage.setItem('sellnation_products', JSON.stringify(products));\
            \} catch (error) \{\
                console.error('Error saving products:', error);\
            \}\
        \}\
\
        function openLoginModal() \{\
            document.getElementById('loginModal').classList.add('active');\
        \}\
\
        function closeLoginModal() \{\
            document.getElementById('loginModal').classList.remove('active');\
            document.getElementById('loginUsername').value = '';\
            document.getElementById('loginPassword').value = '';\
            document.getElementById('loginError').style.display = 'none';\
        \}\
\
        function handleLogin() \{\
            const username = document.getElementById('loginUsername').value;\
            const password = document.getElementById('loginPassword').value;\
            const errorDiv = document.getElementById('loginError');\
\
            const account = STAFF_ACCOUNTS[username];\
            if (!account || account.password !== password) \{\
                errorDiv.textContent = 'Invalid username or password';\
                errorDiv.style.display = 'block';\
                return;\
            \}\
\
            currentUser = \{ username: username, role: account.role \};\
            \
            try \{\
                localStorage.setItem('sellnation_session', JSON.stringify(currentUser));\
            \} catch (error) \{\
                console.error('Error saving session:', error);\
            \}\
\
            closeLoginModal();\
            updateUIForLoggedInUser();\
        \}\
\
        function handleLogout() \{\
            currentUser = null;\
            try \{\
                localStorage.removeItem('sellnation_session');\
            \} catch (error) \{\
                console.error('Error deleting session:', error);\
            \}\
            updateUIForLoggedInUser();\
            renderProducts();\
        \}\
\
        function updateUIForLoggedInUser() \{\
            const headerActions = document.getElementById('headerActions');\
            const staffPanel = document.getElementById('staffPanel');\
\
            if (currentUser) \{\
                const roleIcon = currentUser.role === 'ownership' ? '\uc0\u55357 \u56628 ' : \
                                currentUser.role === 'admin' ? '\uc0\u55357 \u57313 ' : '\u55357 \u56629 ';\
                \
                headerActions.innerHTML = `\
                    <div class="user-info">\
                        <span>$\{roleIcon\} $\{currentUser.username\}</span>\
                        <span class="role-badge">$\{currentUser.role\}</span>\
                        <button class="btn btn-danger" onclick="handleLogout()" style="padding: 6px 12px; font-size: 12px;">Logout</button>\
                    </div>\
                `;\
                staffPanel.style.display = 'block';\
            \} else \{\
                headerActions.innerHTML = `\
                    <button class="btn btn-primary" onclick="openLoginModal()">Staff Login</button>\
                `;\
                staffPanel.style.display = 'none';\
            \}\
        \}\
\
        function addProduct() \{\
            const name = document.getElementById('productName').value;\
            const price = document.getElementById('productPrice').value;\
            const description = document.getElementById('productDescription').value;\
\
            if (!name || !price) \{\
                alert('Please fill in product name and price');\
                return;\
            \}\
\
            const product = \{\
                id: Date.now(),\
                name: name,\
                price: parseFloat(price),\
                description: description,\
                addedBy: currentUser.username,\
                addedAt: new Date().toISOString()\
            \};\
\
            products.push(product);\
            saveProducts();\
            \
            document.getElementById('productName').value = '';\
            document.getElementById('productPrice').value = '';\
            document.getElementById('productDescription').value = '';\
            \
            renderProducts();\
        \}\
\
        function removeProduct(id) \{\
            if (currentUser.role !== 'admin' && currentUser.role !== 'ownership') \{\
                alert('Only admins and ownership can remove products');\
                return;\
            \}\
\
            if (confirm('Are you sure you want to remove this product?')) \{\
                products = products.filter(p => p.id !== id);\
                saveProducts();\
                renderProducts();\
            \}\
        \}\
\
        function renderProducts() \{\
            const container = document.getElementById('productsContainer');\
\
            if (products.length === 0) \{\
                container.innerHTML = `\
                    <div class="empty-state">\
                        <div class="empty-icon">\uc0\u55357 \u57042 </div>\
                        <p style="font-size: 20px; color: #ddd6fe; margin-bottom: 10px;">No products available yet</p>\
                        $\{!currentUser ? '<p style="color: #a78bfa;">Staff can add products from the staff panel</p>' : ''\}\
                    </div>\
                `;\
                return;\
            \}\
\
            const productsHTML = products.map(product => \{\
                const canRemove = currentUser && (currentUser.role === 'admin' || currentUser.role === 'ownership');\
                const isStaff = currentUser && currentUser.role === 'staff';\
                \
                let buttonsHTML = `\
                    <button class="btn btn-primary" onclick="openRobloxHub()" style="width: 100%; margin-bottom: 10px;">\
                        Buy Now - Visit Hub\
                    </button>\
                `;\
\
                if (currentUser) \{\
                    buttonsHTML += `<div class="product-meta">Added by: $\{product.addedBy\}</div>`;\
                    \
                    if (canRemove) \{\
                        buttonsHTML += `\
                            <button class="btn btn-danger" onclick="removeProduct($\{product.id\})" style="width: 100%; padding: 8px; margin-top: 10px;">\
                                \uc0\u55357 \u56785 \u65039  Remove Product\
                            </button>\
                        `;\
                    \} else if (isStaff) \{\
                        buttonsHTML += `\
                            <p style="font-size: 12px; color: #a78bfa; text-align: center; margin-top: 10px;">Only admins can remove products</p>\
                        `;\
                    \}\
                \}\
                \
                return `\
                    <div class="product-card">\
                        <div class="product-name">$\{product.name\}</div>\
                        <div class="product-price">$\{product.price\} Robux</div>\
                        $\{product.description ? `<div class="product-description">$\{product.description\}</div>` : ''\}\
                        $\{buttonsHTML\}\
                    </div>\
                `;\
            \}).join('');\
\
            container.innerHTML = '<div class="products-grid">' + productsHTML + '</div>';\
        \}\
\
        function openRobloxHub() \{\
            window.open(ROBLOX_HUB_URL, '_blank');\
        \}\
\
        // Allow Enter key to submit login\
        document.getElementById('loginPassword').addEventListener('keypress', (e) => \{\
            if (e.key === 'Enter') \{\
                handleLogin();\
            \}\
        \});\
    </script>\
</body>\
